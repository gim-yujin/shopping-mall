        {"expr": "shopping_mall:async_queue_fill_ratio", "refId": "A", "legendFormat": "Queue Fill Ratio"},
        {"expr": "shopping_mall:backpressure_level / 2", "refId": "B", "legendFormat": "Pressure Level (0~1)"}
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {"unit": "s", "custom": {"fillOpacity": 10}},
        "overrides": []
