      "type": "timeseries",
      "targets": [{"expr": "shopping_mall:cache_hit_ratio:rate1m", "refId": "A", "legendFormat": "{{cache}}"}]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {"unit": "percentunit", "decimals": 1, "min": 0, "max": 1, "custom": {"fillOpacity": 15}},
        "overrides": []
