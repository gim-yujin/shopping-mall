          {"matcher": {"id": "byName", "options": "conflict"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]},
          {"matcher": {"id": "byName", "options": "new"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}}]}
